services:
  mysql:
    image: mysql:8.0
    container_name: cloud1_mysql
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: "{{ mysql_root_password }}"
      MYSQL_DATABASE: "{{ mysql_database }}"
      MYSQL_USER: "{{ mysql_user }}"
      MYSQL_PASSWORD: "{{ mysql_password }}"
    volumes:
      - mysql_data:/var/lib/mysql
    networks:
      - backend

  wordpress:
    image: wordpress:php8.2-fpm
    container_name: cloud1_wordpress
    restart: unless-stopped
    depends_on:
      - mysql
    environment:
      WORDPRESS_DB_HOST: mysql
      WORDPRESS_DB_NAME: "{{ mysql_database }}"
      WORDPRESS_DB_USER: "{{ mysql_user }}"
      WORDPRESS_DB_PASSWORD: "{{ mysql_password }}"
    volumes:
      - wordpress_data:/var/www/html
    networks:
      - backend
      - frontend

  phpmyadmin:
    image: phpmyadmin:latest
    container_name: cloud1_phpmyadmin
    restart: unless-stopped
    depends_on:
      - mysql
    environment:
      PMA_HOST: mysql
      PMA_ABSOLUTE_URI: "http://{{ domain_name }}/phpmyadmin/"
    networks:
      - backend
      - frontend

  nginx:
    image: nginx:alpine
    container_name: cloud1_nginx
    restart: unless-stopped
    depends_on:
      - wordpress
      - phpmyadmin
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - wordpress_data:/var/www/html:ro
      - {{ app_dir }}/nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - {{ app_dir }}/certs:/etc/nginx/certs:ro
    networks:
      - frontend

networks:
  frontend:
  backend:

volumes:
  mysql_data:
  wordpress_data:
