# This file is rendered by Ansible onto the remote server.
# Only Nginx publishes host ports; MySQL/PHP services are reachable only on
# Docker networks, which prevents direct database access from the Internet.
services:
  mysql:
    image: mysql:8.0
    container_name: cloud1_mysql
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: "{{ mysql_root_password }}"
      MYSQL_DATABASE: "{{ mysql_database }}"
      MYSQL_USER: "{{ mysql_user }}"
      MYSQL_PASSWORD: "{{ mysql_password }}"
    volumes:
      # Named volumes survive container recreation and server reboots.
      - mysql_data:/var/lib/mysql
    networks:
      - backend

  wordpress:
    # FPM contains the PHP runtime only; Nginx is the separate public web server.
    image: wordpress:php8.2-fpm
    container_name: cloud1_wordpress
    restart: unless-stopped
    depends_on:
      - mysql
    environment:
      WORDPRESS_DB_HOST: mysql
      WORDPRESS_DB_NAME: "{{ mysql_database }}"
      WORDPRESS_DB_USER: "{{ mysql_user }}"
      WORDPRESS_DB_PASSWORD: "{{ mysql_password }}"
    volumes:
      - wordpress_data:/var/www/html
    networks:
      - backend
      - frontend

  phpmyadmin:
    # phpMyAdmin is not published directly. Nginx exposes it only under /phpmyadmin/.
    image: phpmyadmin:5.2
    container_name: cloud1_phpmyadmin
    restart: unless-stopped
    depends_on:
      - mysql
    environment:
      PMA_HOST: mysql
      # Required because phpMyAdmin is behind Nginx at a sub-path.
      PMA_ABSOLUTE_URI: "{{ site_scheme }}://{{ domain_name }}/phpmyadmin/"
    networks:
      - backend
      - frontend

  nginx:
    image: nginx:alpine
    container_name: cloud1_nginx
    restart: unless-stopped
    depends_on:
      - wordpress
      - phpmyadmin
    ports:
      # These are the only application ports published on the host.
      - "80:80"
      - "443:443"
    volumes:
      # Nginx needs read-only access to WordPress files for static assets.
      - wordpress_data:/var/www/html:ro
      - {{ app_dir }}/nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - {{ app_dir }}/certs:/etc/nginx/certs:ro
    networks:
      - frontend

  wpcli:
    # WP-CLI is a one-shot setup tool, not a permanent process. The "tools"
    # profile keeps it out of a normal `docker compose up -d`.
    image: wordpress:cli-php8.2
    profiles:
      - tools
    user: "33:33"
    working_dir: /var/www/html
    depends_on:
      - mysql
    environment:
      HOME: /tmp
      WORDPRESS_DB_HOST: mysql
      WORDPRESS_DB_NAME: "{{ mysql_database }}"
      WORDPRESS_DB_USER: "{{ mysql_user }}"
      WORDPRESS_DB_PASSWORD: "{{ mysql_password }}"
    volumes:
      - wordpress_data:/var/www/html
    networks:
      - backend

networks:
  frontend:
  # `internal: true` prevents direct external routing to database-side services.
  backend:
    internal: true

volumes:
  mysql_data:
  wordpress_data:
